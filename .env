# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Générer : php -r "echo bin2hex(random_bytes(16));"  puis le mettre dans .env.local
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# Valeur d'exemple : mettez vos vraies valeurs dans .env.local (non versionné), jamais ici.
DATABASE_URL="mysql://app:CHANGE_ME@127.0.0.1:3306/peasantgo?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
# Exemple Gmail : MAILER_DSN=gmail://adresse@gmail.com:mot-de-passe-application@default (composer require symfony/google-mailer)
MAILER_FROM=no-reply@peasantgo.tn
###< symfony/mailer ###

###> satellites ###
# Agromonitoring (https://agromonitoring.com/api/get) : NDVI + images par terrain
AGRO_API_KEY=
# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu) : client OAuth Sentinel Hub
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Earth Search (catalogue Sentinel-2 public, sans clé) : 1 = activé
EARTHSEARCH_ENABLED=1
# Données NDVI simulées pour tester sans clé (ne jamais activer en production)
SATELLITE_DEMO=0
###< satellites ###

###> robot PeasantGo.AI ###
# Google Gemini (https://aistudio.google.com/apikey) : conseils, analyse des images, lecture des sites officiels.
# Sans clé, le robot fonctionne avec ses règles internes (pas de texte rédigé par l'IA).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Open-Meteo : gratuit et sans clé pour un usage non commercial ; clé seulement pour l'offre commerciale.
OPEN_METEO_API_KEY=
# Météo simulée pour tester hors ligne (ne jamais activer en production)
METEO_DEMO=0
# SMS des alertes du robot. null://null = aucun SMS envoyé. Exemples (installer le bridge correspondant) :
#   composer require symfony/orange-sms-notifier → SMS_DSN=orange-sms://CLIENT_ID:CLIENT_SECRET@default?from=FROM&sender_name=PeasantGo
#   composer require symfony/twilio-notifier     → SMS_DSN=twilio://SID:TOKEN@default?from=+216XXXXXXXX
SMS_DSN=null://null
###< robot PeasantGo.AI ###

###> formations payantes ###
# 1 = l'achat est validé tout de suite (essais uniquement). 0 = l'équipe vérifie chaque paiement dans l'administration.
PAIEMENT_DEMO=0
# Où payer, affiché dans la fenêtre d'achat (ex. « D17 : 22 000 000 – RIB : 08 000 0000000000000 00 »)
PAIEMENT_COMPTE=
###< formations payantes ###
