{% extends '_layout/site.html.twig' %}
{% set active = cle %}
{% block title %}{{ titre|trans }} – PeasantGo.AI{% endblock %}
{% block body %}
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h1 class="h3 section-title mb-1"><i class="fas {{ icone }} me-2"></i>{{ titre|trans }}</h1>
        <p class="text-muted mb-0">{{ intro|trans }}</p>
    </div>
</div>
{% block contenu %}
<div class="card shadow-sm">
    <div class="card-body text-center text-muted py-5">
        <i class="fas fa-hammer fa-2x mb-3"></i>
        <p class="mb-0">{{ 'Page en préparation.'|trans }}</p>
    </div>
</div>
{% endblock %}
{% endblock %}
