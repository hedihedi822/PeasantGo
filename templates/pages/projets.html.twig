{% extends 'pages/_base.html.twig' %}
{% block contenu %}
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5 fw-bold"><i class="fas fa-snowflake me-2 text-pg"></i>{{ 'Un mini-frigo pour chaque agriculteur'|trans }}</h2>
        <p class="text-muted mb-0">{{ 'Un projet commun à l\'État, aux associations, au syndicat des agriculteurs et à tous les partenaires : chaque agriculteur dispose d\'une petite chambre froide pour stocker sa récolte et la vendre au meilleur moment, au lieu de la brader quand le marché est saturé.'|trans }}</p>
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-body text-center text-muted py-5">
        <i class="fas fa-hammer fa-2x mb-3"></i>
        <p class="mb-0">{{ 'Page en préparation.'|trans }}</p>
    </div>
</div>
{% endblock %}
