<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:0;background:#f5f7f9;font-family:Segoe UI,Arial,sans-serif;color:#343a40">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7f9;padding:24px 0">
        <tr><td align="center">
            <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;background:#fff;border-radius:10px;overflow:hidden">
                <tr><td style="background:#2c7d4b;color:#fff;padding:18px 24px;font-size:20px;font-weight:600">PeasantGo.AI</td></tr>
                <tr><td style="padding:24px">
                    <p style="margin:0 0 12px">Bonjour {{ nom }},</p>
                    <h2 style="margin:0 0 12px;font-size:18px;color:#2c7d4b">{{ titre }}</h2>
                    <div style="line-height:1.6">{{ message|nl2br }}</div>
                    <p style="margin:24px 0 0">
                        <a href="{{ lien }}" style="background:#2c7d4b;color:#fff;text-decoration:none;padding:10px 18px;border-radius:6px;display:inline-block">Voir sur PeasantGo.AI</a>
                    </p>
                </td></tr>
                <tr><td style="padding:16px 24px;background:#f8f9fa;font-size:12px;color:#6c757d">
                    Vous recevez cet email parce que vous avez un compte PeasantGo.AI.
                    Pour ne plus recevoir ces emails, désactivez « Notifications par email » dans
                    <a href="{{ parametres }}" style="color:#2c7d4b">vos paramètres</a>.
                </td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
