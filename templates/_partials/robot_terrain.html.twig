{# Résultats du robot PeasantGo.AI pour le terrain actif (chargés en JSON depuis /api/robot/terrain).
   Le tableau est rendu par public/js/robot-table.js, le même que pour les visiteurs. #}
<script src="/js/robot-table.js" defer></script>
<style>
    .robot-card { border-radius: 12px; }
    .meteo-jour { flex: 1 1 0; min-width: 74px; text-align: center; border-radius: 8px; padding: .4rem .2rem; background: #f6faf7; }
    .meteo-jour .t { font-weight: 700; }
    .reco { background: #eaf6ee !important; }
    .badge-reco { background: var(--primary-color); }
    .robot-table th { white-space: nowrap; font-size: .82rem; }
    .robot-table td { font-size: .9rem; vertical-align: middle; }
    .robot-table .culture-link { font-weight: 600; color: var(--primary-color); text-decoration: none; }
    .barre { height: 6px; border-radius: 3px; background: #e9ecef; overflow: hidden; min-width: 60px; }
    .barre > div { height: 100%; }
    #robotDetail dt { color: var(--primary-color); font-weight: 600; }
    .robot-loading { min-height: 120px; display: flex; align-items: center; justify-content: center; }
    .robot-section-titre { font-size: 1rem; font-weight: 700; color: var(--primary-color); margin: 1.2rem 0 .4rem; }
</style>

<div class="card shadow-sm mb-4 robot-card">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="section-title mb-1"><i class="fas fa-robot me-2"></i>{{ 'Robot PeasantGo.AI'|trans }} – <span id="rbTerrainNom">{{ terrain.nom }}</span></h4>
            <div class="text-muted small" id="rbTerrainInfo">{{ terrain.surface|number_format(2, ',', ' ') }} ha · {{ terrain.localisation ?: ('localité non renseignée'|trans) }}</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#formulaireTerrainModal"><i class="fas fa-clipboard-list me-1"></i>{{ 'Formulaire du terrain'|trans }}</button>
            <button type="button" class="btn btn-success btn-sm" id="rbActualiser"><i class="fas fa-sync me-1"></i>{{ 'Actualiser l\'analyse'|trans }}</button>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card shadow-sm h-100 robot-card">
            <div class="card-body">
                <h6 class="fw-bold"><i class="fas fa-cloud-sun me-2 text-success"></i>{{ 'Météo des 7 prochains jours'|trans }}</h6>
                <div id="rbMeteo" class="d-flex gap-2 overflow-auto pb-1"><div class="robot-loading w-100 text-muted small">{{ 'Chargement…'|trans }}</div></div>
                <div class="small text-muted mt-2" id="rbMeteoSource"></div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4 robot-card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h4 class="section-title mb-0"><i class="fas fa-seedling me-2"></i>{{ 'Le tableau de votre terrain'|trans }}</h4>
            <small class="text-muted" id="rbCalcule"></small>
        </div>
        <div id="rbErreurs" class="mt-2"></div>

        <h5 class="robot-section-titre"><i class="fas fa-clipboard-check me-1"></i>{{ '1. Ce que vous avez prévu cette saison'|trans }}</h5>
        <div class="table-responsive table-container"><table class="table table-hover robot-table mb-0" id="rbTablePrevues"></table></div>
        <div id="rbPrevuesVide" class="small text-muted d-none mt-1">{{ "Vous n'avez encore rien prévu pour cette saison."|trans }} <a href="#" data-ouvrir="1">{{ 'Dites au robot ce que vous pensez cultiver ou élever'|trans }}</a> : {{ "il l'estimera en premier."|trans }}</div>

        <h5 class="robot-section-titre"><i class="fas fa-robot me-1"></i>{{ '2. Ce que le robot vous recommande'|trans }}</h5>
        <div class="table-responsive table-container"><table class="table table-hover robot-table mb-0" id="rbTableReco"></table></div>

        <button type="button" class="btn btn-link btn-sm px-0 mt-2" id="rbVoirTout"><i class="fas fa-list me-1"></i>{{ 'Voir toutes les cultures et tous les élevages'|trans }}</button>
        <div class="table-responsive table-container d-none" id="rbToutBox"><table class="table table-hover robot-table mb-0" id="rbTableTout"></table></div>

        <p class="small text-muted mt-2 mb-0">{{ 'Cliquez sur'|trans }} <strong><i class="fas fa-calculator"></i> {{ 'Détail'|trans }}</strong> {{ "pour le détail du calcul. Bénéfice = production × prix × (30 % + 70 % × réussite) − coût. Pour l'élevage, le calcul est fait pour votre effectif prévu (sinon un effectif type)."|trans }}</p>
    </div>
</div>

<div class="modal fade" id="robotDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="robotDetailTitre">{{ 'Détail du calcul'|trans }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body small" id="robotDetail"></div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const { api, esc, toast, formatDate, formatNumber } = PG;
    let donnees = null;

    const jourMois = iso => { const [, m, d] = iso.split('-'); return `${d}/${m}`; };
    const periode = p => `${jourMois(p[0])} → ${jourMois(p[1])}`;
    const couleur = v => v >= 70 ? '#2e7d32' : v >= 45 ? '#ef6c00' : '#c62828';
    const ICONES = c => c === null ? 'fa-cloud' : c <= 1 ? 'fa-sun' : c <= 3 ? 'fa-cloud-sun' : c <= 48 ? 'fa-smog' : c <= 67 ? 'fa-cloud-rain' : c <= 77 ? 'fa-snowflake' : c <= 82 ? 'fa-cloud-showers-heavy' : 'fa-bolt';
    const JOURS = {{ ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam']|map(j => j|trans)|json_encode|raw }};

    function renderMeteo(d) {
        const box = document.getElementById('rbMeteo');
        if (!d.meteo.length) { box.innerHTML = '<p class="text-muted small mb-0">{{ 'Météo indisponible pour le moment.'|trans|e('js') }}</p>'; return; }
        box.innerHTML = d.meteo.map(j => `<div class="meteo-jour">
            <div class="small text-muted">${JOURS[new Date(j.date).getDay()]} ${jourMois(j.date)}</div>
            <i class="fas ${ICONES(j.code)} fa-lg my-1 text-warning"></i>
            <div class="t">${Math.round(j.tmax)}°<span class="text-muted fw-normal"> / ${Math.round(j.tmin)}°</span></div>
            <div class="small text-primary">${j.pluie > 0 ? formatNumber(j.pluie, 1) + ' mm' : '—'}</div></div>`).join('');
        document.getElementById('rbMeteoSource').textContent = d.meteoDemo ? '{{ 'Météo simulée (mode démonstration).'|trans|e('js') }}' : '{{ 'Source : Open-Meteo, au point exact du terrain.'|trans|e('js') }}';
    }

    const groupes = {};
    function remplir(id, liste, grp, vide) {
        groupes[grp] = liste;
        document.getElementById(id).innerHTML = PGRobot.ENTETE + '<tbody>' + PGRobot.lignes(liste, { detail: grp, vide }) + '</tbody>';
    }
    function renderLignes(d) {
        document.getElementById('rbCalcule').textContent = d.calculeLe ? '{{ 'Calculé le'|trans|e('js') }} ' + d.calculeLe : '';
        document.getElementById('rbErreurs').innerHTML = d.erreurs.length ? `<div class="alert alert-warning small py-2">${d.erreurs.map(esc).join('<br>')}</div>` : '';
        document.getElementById('rbPrevuesVide').classList.toggle('d-none', d.prevues.length > 0);
        document.getElementById('rbTablePrevues').classList.toggle('d-none', !d.prevues.length);
        remplir('rbTablePrevues', d.prevues, 'p', '');
        remplir('rbTableReco', d.lignes.filter(l => l.recommande), 'r', '{{ 'Aucune culture rentable trouvée pour ce terrain avec les données actuelles.'|trans|e('js') }}');
        remplir('rbTableTout', d.lignes, 't', '{{ "Aucune estimation : vérifiez la localité du terrain puis cliquez sur « Actualiser l'analyse »."|trans|e('js') }}');
    }
    document.getElementById('rbVoirTout').addEventListener('click', function () {
        const box = document.getElementById('rbToutBox');
        box.classList.toggle('d-none');
        this.innerHTML = box.classList.contains('d-none') ? '<i class="fas fa-list me-1"></i>{{ 'Voir toutes les cultures et tous les élevages'|trans|e('js') }}' : '<i class="fas fa-chevron-up me-1"></i>{{ 'Masquer la liste complète'|trans|e('js') }}';
    });
    document.addEventListener('click', e => {
        const o = e.target.closest('[data-ouvrir]');
        if (o && window.PG_ouvrirFormulaire) { e.preventDefault(); PG_ouvrirFormulaire(o.dataset.ouvrir); }
    });

    function detail(l) {
        const d = l.details, c = d.climat || {}, px = d.prix || {}, ct = d.cout || {};
        document.getElementById('robotDetailTitre').textContent = `${l.nom} – détail du calcul`;
        const postes = Object.entries(ct.postes || {}).map(([k, v]) => `<tr><td>${esc(k)}</td><td class="text-end">${formatNumber(v, 0)} DT/ha</td><td class="text-muted">${esc((ct.sources || {})[k] || '')}</td></tr>`).join('');
        document.getElementById('robotDetail').innerHTML = `
            <dl class="row mb-2">
                <dt class="col-sm-4">Saison</dt><dd class="col-sm-8">Semis ${formatDate(l.cultivation[0])}, fin ${formatDate(l.cultivation[1])}, récolte ${formatDate(l.exploitation[0])} → ${formatDate(l.exploitation[1])} <span class="text-muted">(${d.saisonSource === 'catalogue' ? 'dates officielles du catalogue' : 'calendrier de référence'})</span></dd>
                <dt class="col-sm-4">Climat (${c.nbAnnees || 0} années)</dt><dd class="col-sm-8">${!c.nbAnnees ? 'historique météo indisponible : valeurs moyennes utilisées.'
                    : PGRobot.estAnimal(l) ? `${c.anneesReussies}/${c.nbAnnees} années favorables · ${c.joursChaleurMoyen} j de chaleur${c.joursFroidMoyen ? ' · ' + c.joursFroidMoyen + ' j de froid' : ''}${c.besoinEau ? ` · pluie avant la saison ${formatNumber(c.pluieMoyenne, 0)} mm pour ${c.besoinEau} mm utiles` : ''}. Principal risque : <strong>${esc(c.principalRisque)}</strong>.`
                    : `${c.anneesReussies}/${c.nbAnnees} années favorables · pluie ${formatNumber(c.pluieMoyenne, 0)} mm pour un besoin de ${c.besoinEau} mm${d.irrigue ? ' (irrigué)' : ''} · gel ${c.joursGelMoyen} j · chaleur ${c.joursChaleurMoyen} j · degrés-jours ${formatNumber(c.gddMoyen, 0)}/${c.gddRequis}. Principal risque : <strong>${esc(c.principalRisque)}</strong>.`}</dd>
                ${(d.prevision || []).length ? `<dt class="col-sm-4">Prévisions</dt><dd class="col-sm-8">${d.prevision.map(esc).join(', ')}</dd>` : ''}
                <dt class="col-sm-4">Satellite</dt><dd class="col-sm-8">${esc(d.satellite?.note || '—')}</dd>
                <dt class="col-sm-4">Apprentissage</dt><dd class="col-sm-8">${d.apprentissage ? `${d.apprentissage.recoltes} récolte(s) déclarée(s) (${esc(d.apprentissage.zone)}), ${d.apprentissage.reussites} réussie(s), rendement réel / estimé × ${d.apprentissage.facteurRendement}` : 'aucune récolte déclarée pour cette culture dans la zone pour l\'instant'}</dd>
                <dt class="col-sm-4">${PGRobot.estAnimal(l) ? 'Production par animal' : 'Rendement'}</dt><dd class="col-sm-8">${PGRobot.estAnimal(l)
                    ? `${formatNumber(d.rendementHa * 1000 / d.affichage[1], 1)} ${esc(d.affichage[0])} par ${esc(PGRobot.singulier(d.unite))} (référence ${formatNumber(d.rendementBase * 1000 / d.affichage[1], 1)}), pour ${d.taille} ${esc(d.unite)}`
                    : `${formatNumber(d.rendementHa, 2)} t/ha (référence ${d.rendementBase} t/ha ${d.irrigue ? 'irrigué' : 'en sec'})`}</dd>
            </dl>
            <h6 class="fw-bold">Coût : ${formatNumber(ct.total, 0)} DT (${formatNumber(ct.parHa, 0)} DT/ha)</h6>
            <table class="table table-sm"><tbody>${postes}</tbody></table>
            <h6 class="fw-bold">Prix : ${formatNumber(l.prix, 3)} DT/kg${PGRobot.estAnimal(l) && d.affichage[1] !== 1 ? ` (${formatNumber(l.prix * d.affichage[1], 3)} DT/${esc(PGRobot.singulier(d.affichage[0]))})` : ''}</h6>
            <ul class="mb-2">
                <li>Prix de référence : ${formatNumber(px.prixReference?.valeur, 3)} DT/kg (${esc(px.prixReference?.source || '')})</li>
                ${px.couverture != null ? `<li>Le gouvernorat produit ${px.couverture} % de ce qu'il consomme.</li>` : ''}
                ${(px.etapes || []).map(e => `<li>${esc(e)}</li>`).join('')}
                <li>Indice des salaires (SMIG) : × ${px.indiceSalaires}</li>
                <li>Historique : ${px.historique?.n ? `${px.historique.n} prix observés, moyenne ${formatNumber(px.historique.prix, 3)} DT/kg (poids ${Math.round(px.poidsHistorique * 100)} %)` : 'aucun prix observé à cette période pour l\'instant'}</li>
                ${px.offreRecommandee ? `<li>Anti-saturation : ${px.offreRecommandee.terrains} terrain(s) voisin(s) ont la même recommandation, ${formatNumber(px.offreRecommandee.prisEnCompte, 0)} t comptées comme offre à venir.</li>` : ''}
                ${px.correctionApprise ? `<li>Correction apprise des ventes déclarées : × ${px.correctionApprise.facteur}</li>` : ''}
            </ul>
            <h6 class="fw-bold">Exportation : ${l.exportation ? 'oui' : 'non'}</h6>
            <p class="mb-0">${d.export ? (d.export.solde > 0 ? `La Tunisie aurait un surplus d'environ ${formatNumber(d.export.solde, 0)} t.` : `La Tunisie aurait un manque d'environ ${formatNumber(-d.export.solde, 0)} t.`) + (d.export.destinations?.length ? ' Débouchés les plus proches : ' + d.export.destinations.map(x => `${esc(x.zone)} (${formatNumber(x.quantite, 0)} t)`).join(', ') + '.' : '') + ` <span class="text-muted">Source : ${esc(d.export.source)}.</span>` : 'bilan national inconnu.'}</p>`;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('robotDetailModal')).show();
    }

    async function charger() {
        try {
            donnees = await api('/api/robot/terrain');
            if (!donnees.terrain) return;
            const t = donnees.terrain;
            document.getElementById('rbTerrainInfo').textContent = `${formatNumber(t.surface)} {{ 'ha'|trans|e('js') }} · ${t.localite || '—'}${t.gouvernorat ? ', ' + t.gouvernorat : ''} · ${t.irrigue ? '{{ 'irrigué'|trans|e('js') }}' : '{{ "en sec (pas de compteur d'eau)"|trans|e('js') }}'}${t.contour ? ' · {{ 'contour GPS'|trans|e('js') }}' : ''}`;
            renderMeteo(donnees); renderLignes(donnees);
        } catch (e) {
            document.getElementById('rbErreurs').innerHTML = `<div class="alert alert-danger small py-2">${esc(e.message)}</div>`;
        }
    }

    document.addEventListener('click', e => {
        const b = e.target.closest('[data-detail]');
        if (!b) return;
        const [g, i] = b.dataset.detail.split(':');
        if (groupes[g]) detail(groupes[g][i]);
    });
    document.getElementById('rbActualiser').addEventListener('click', async function () {
        this.disabled = true;
        const html = this.innerHTML;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>{{ 'Analyse en cours…'|trans|e('js') }}';
        try {
            const r = await api('/api/robot/terrain/analyser', { method: 'POST' });
            toast(r.message);
            (r.erreurs || []).slice(0, 3).forEach(m => toast(m, 'warning'));
            await charger();
        } catch (err) { toast(err.message, err.status === 429 ? 'info' : 'danger'); }
        this.disabled = false;
        this.innerHTML = html;
    });
    document.addEventListener('pg:terrain-modifie', () => charger()); // le serveur recalcule si le plan a changé

    charger();
});
</script>
